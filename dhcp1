  defaultSort:'ip',
  validate(items,out){
    const live=items.filter(e=>!e.deleted);const byIp=new Map(),byMac=new Map(),byHost=new Map();
    const add=(m,k,e)=>{if(!m.has(k))m.set(k,[]);m.get(k).push(e);};
    const first=e=>e.backend==='dnsmasq'?(e.ip.split(',')[0]||'').trim():e.ip.trim();
    live.forEach(e=>{const ip=first(e);if(ip)add(byIp,e.backend+'|'+ip,e);const m=normMac(e.mac);if(m)add(byMac,e.backend+'|'+(e.backend==='dnsmasq'?'':e.scope)+'|'+m,e);if(e.hostname.trim())add(byHost,e.backend+'|'+e.hostname.trim().toLowerCase(),e);});
    live.forEach(e=>{
      const is=[];const E=m=>is.push({lvl:'err',m}),W=m=>is.push({lvl:'warn',m});
      const macRaw=e.mac.trim();
      if(!macRaw){if(e.backend!=='dnsmasq')E('MAC-Adresse fehlt');}
      else if(e.backend==='dnsmasq'){if(!macRaw.split(',').every(x=>normMac(x)))E('MAC-Adresse ungültig');}
      else if(!normMac(macRaw))E('MAC-Adresse ungültig');
      const ipRaw=e.ip.trim();let n=null;
      if(!ipRaw)E('IP-Adresse fehlt');
      else if(e.backend==='dnsmasq'){const parts=ipRaw.split(',').map(x=>x.trim()).filter(Boolean);if(!parts.every(x=>isV4(x)||isV6(x)))E('IP-Adresse ungültig');const v4=parts.find(isV4);n=v4?ipToInt(v4):null;}
      else{n=ipToInt(ipRaw);if(n==null)E('IP-Adresse ungültig');}
      if(e.backend!=='dnsmasq'){
        const sc=this.scopeFor(e);
        if(!sc)E(e.backend==='kea'?'Kein Subnetz gewählt':'Kein Interface gewählt');
        else if(n!=null&&sc.cidr){
          if(!inCidr(sc.cidr,n))E('IP liegt nicht im Netz '+sc.cidr.label);
          else if(sc.cidr.bits<31&&(n===sc.cidr.net||n===sc.cidr.bcast))E('Netz- oder Broadcast-Adresse');
          if(sc.ifip!=null&&sc.ifip===n)E('Das ist die Adresse der Firewall');
          if(e.backend==='isc'&&sc.enabled===false)W('DHCP-Server auf diesem Interface ist aus');
          if(sc.pools.some(([a,b])=>n>=a&&n<=b))W(S.type==='pfsense'?'Im dynamischen Bereich (pfSense erlaubt das in der Oberfläche nicht)':'Liegt im dynamischen Bereich');
        }
      }
      const h=e.hostname.trim();
      if(h&&!HOST_RE.test(h))E('Hostname nur mit Buchstaben, Ziffern und Bindestrich');
      const ip=first(e);
      if(ip&&(byIp.get(e.backend+'|'+ip)||[]).length>1)E('IP doppelt vergeben');
      const m=normMac(e.mac);if(m&&(byMac.get(e.backend+'|'+(e.backend==='dnsmasq'?'':e.scope)+'|'+m)||[]).length>1)E('MAC doppelt eingetragen');
      if(h&&(byHost.get(e.backend+'|'+h.toLowerCase())||[]).length>1)W('Hostname mehrfach vorhanden');
      out.set(e.id,is);
    });
  },
  onBlur(it,f){
