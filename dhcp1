/* ---------- XML ---------- */
function kids(el,tag){return el?[...el.children].filter(c=>!tag||c.tagName===tag):[];}
function kid(el,tag){return el?([...el.children].find(c=>c.tagName===tag)||null):null;}
function path(el,...tags){for(const t of tags){el=kid(el,t);if(!el)return null;}return el;}
function txt(el,tag){const c=kid(el,tag);return c?c.textContent.trim():'';}
function isOn(el,tag){const c=kid(el,tag);if(!c)return false;const v=c.textContent.trim().toLowerCase();return v===''||v==='1'||v==='yes'||v==='on'||v==='true';}
function indentOf(el){const p=el.previousSibling;if(p&&p.nodeType===3){const m=/\n([ \t]*)$/.exec(p.nodeValue);if(m)return m[1];}return null;}
function depthIndent(el){let d=0,e=el;while(e.parentNode&&e.parentNode.nodeType===1){d++;e=e.parentNode;}return S.unit.repeat(d);}
function indOf(el){const i=indentOf(el);return i==null?depthIndent(el):i;}
function insertChild(parent,el,after){
  const d=S.doc;const els=kids(parent);
  if(!after&&els.length)after=els[els.length-1];
  if(after){const ind=indOf(after);const ref=after.nextSibling;parent.insertBefore(d.createTextNode('\n'+ind),ref);parent.insertBefore(el,ref);}
  else{const pInd=indOf(parent);[...parent.childNodes].forEach(n=>{if(n.nodeType===3&&!n.nodeValue.trim())parent.removeChild(n);});parent.appendChild(d.createTextNode('\n'+pInd+S.unit));parent.appendChild(el);parent.appendChild(d.createTextNode('\n'+pInd));}
}
function removeEl(el){const p=el.previousSibling;if(p&&p.nodeType===3&&!p.nodeValue.trim())p.parentNode.removeChild(p);if(el.parentNode)el.parentNode.removeChild(el);}
function reindent(el){
  const ch=kids(el);if(!ch.length)return;
  const ind=indOf(el),d=S.doc;
  [...el.childNodes].forEach(n=>{if(n.nodeType===3&&!n.nodeValue.trim())el.removeChild(n);});
  ch.forEach(c=>el.insertBefore(d.createTextNode('\n'+ind+S.unit),c));
  el.appendChild(d.createTextNode('\n'+ind));
  ch.forEach(reindent);
}
function setTxt(el,tag,val,cdata){
  const d=S.doc;let c=kid(el,tag);
  if(!c){c=d.createElement(tag);insertChild(el,c,null);}
  const hadC=[...c.childNodes].some(n=>n.nodeType===4);
  while(c.firstChild)c.removeChild(c.firstChild);
  val=val==null?'':String(val);
  if(val!=='')c.appendChild((hadC||cdata)&&!val.includes(']]>')?d.createCDATASection(val):d.createTextNode(val));
}
const ONV=()=>S.type==='pfsense'?'':'1';
function setBool(el,tag,on){
  const c=kid(el,tag);
  if(on){if(c){if(!isOn(el,tag)){while(c.firstChild)c.removeChild(c.firstChild);if(ONV())c.textContent=ONV();}}else{const n=S.doc.createElement(tag);if(ONV())n.textContent=ONV();insertChild(el,n,null);}}
  else if(c)removeEl(c);
}
function makeEl(tag,fields,withUuid){
  const d=S.doc;const el=d.createElement(tag);
  if(withUuid)el.setAttribute('uuid',newUuid());
  fields.forEach(([t,v])=>{const c=d.createElement(t);if(v)c.appendChild(d.createTextNode(v));el.appendChild(c);});
  return el;
}
function blankClone(tpl){
  const c=tpl.cloneNode(true);
  kids(c).forEach(ch=>{const had=kids(ch).length>0;const v=ch.textContent.trim();while(ch.firstChild)ch.removeChild(ch.firstChild);if(!had&&/^[01]$/.test(v))ch.appendChild(S.doc.createTextNode('0'));});
  if(c.hasAttribute('uuid'))c.setAttribute('uuid',newUuid());
