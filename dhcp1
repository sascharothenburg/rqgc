/* ================= parse & init ================= */
function parseConfig(text){
  text=String(text).replace(/^\ufeff/,'');
  if(/-{4}\s*BEGIN config\.xml\s*-{4}/.test(text))throw new Error('Diese Sicherung ist verschlüsselt. Lade sie in der Firewall ohne Verschlüsselung herunter und öffne sie dann hier.');
  const doc=new DOMParser().parseFromString(text,'application/xml');
  if(doc.getElementsByTagName('parsererror').length)throw new Error('Die Datei ist kein gültiges XML. Prüfe, ob es die config.xml aus der Sicherung ist.');
  const root=doc.documentElement;const type=root.tagName.toLowerCase();
  if(type!=='pfsense'&&type!=='opnsense')throw new Error('Das ist keine vollständige pfSense- oder OPNsense-Konfiguration. Das oberste Element heißt <'+root.tagName+'>.');
  const dm=/^\s*(<\?xml[^>]*\?>)/.exec(text);const um=/\n([ \t]+)</.exec(text);
  const M={doc,root,type,decl:dm?dm[1]:'<?xml version="1.0"?>',unit:um?um[1]:'\t',interfaces:[],data:{}};
  kids(kid(root,'interfaces')).forEach(i=>{const ip=txt(i,'ipaddr');M.interfaces.push({key:i.tagName,descr:txt(i,'descr')||i.tagName.toUpperCase(),ip,cidr:cidrOf(ip,parseInt(txt(i,'subnet'),10))});});
  ORDER.forEach(k=>MODS[k].parse(M));
  return M;
}
function loadText(text,name){
  const M=parseConfig(text);
  const keep=S&&name===undefined?{tab:S.tab,view:S.view,fileName:S.fileName}:null;
  S=Object.assign(M,{fileName:keep?keep.fileName:(name||'config.xml'),baseText:text,unsaved:false,lastXml:null,confirmErr:false,tab:keep?keep.tab:'dhcp',view:{}});
  ORDER.forEach(k=>{const m=MODS[k];S.view[k]=keep?keep.view[k]:{group:m.defaultGroup(),sub:'all',q:'',issues:false,sort:{key:m.defaultSort||null,dir:1}};});
  if(!keep){const firstWith=ORDER.find(k=>S.data[k].items.length);if(firstWith)S.tab=firstWith;}
  $('#start').hidden=true;$('#app').hidden=false;$('#reloadBtn').hidden=false;
  $('#fileinfo').innerHTML='<span class="badge">'+(S.type==='pfsense'?'pfSense':'OPNsense')+'</span>'+esc(S.fileName);
  $('#loadErr').hidden=true;
  const sw=$('#saveWhat');
  sw.innerHTML='<option value="full">Komplette config.xml</option>'+(S.type==='pfsense'?'<option value="dhcpd">Nur Bereich DHCP (Restore area)</option><option value="aliases">Nur Bereich Aliase (Restore area)</option><option value="filter">Nur Bereich Firewallregeln (Restore area)</option>':'');
  $('#areaHelp').hidden=S.type!=='pfsense';
  closeImport();renderAll();
}
async function openFile(file){
  try{const t=await file.text();loadText(t,file.name);}
  catch(err){if(S&&!$('#app').hidden)toast(err.message);else{const b=$('#loadErr');b.textContent=err.message;b.hidden=false;}}
}

