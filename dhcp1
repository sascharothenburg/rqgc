function ruleIssues(r,names,keys){
  const is=[];
  if(!r.floating&&!keys.has(r.iface))is.push({lvl:'warn',m:'Unbekanntes Interface'});
  is.push(...epIssues(r.src,r.ipproto,names,keys,'Quelle'),...epIssues(r.dst,r.ipproto,names,keys,'Ziel'));
  const tu=['tcp','udp','tcp/udp'].includes(r.proto);
  if((r.sport.trim()||r.dport.trim())&&!tu)is.push({lvl:'err',m:'Ports nur bei TCP oder UDP'});
  else{is.push(...portIssues(r.sport,names,'Quellport'),...portIssues(r.dport,names,'Zielport'));}
