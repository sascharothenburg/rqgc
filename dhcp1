function isNetTok(v,keys){if(v==='(self)')return true;if(keys.has(v))return true;if(/ip$/.test(v)&&keys.has(v.slice(0,-2)))return true;return false;}
function epIssues(tok,ipv,names,keys,label){
  const out=[];let v=String(tok||'').trim();if(v.startsWith('!'))v=v.slice(1).trim();
  if(!v||v==='any'||isNetTok(v,keys))return out;
  if(isV4(v)||isV4Cidr(v)){if(ipv==='inet6')out.push({lvl:'err',m:label+' ist IPv4, Regel ist IPv6'});return out;}
  if(isV6(v)||isV6Cidr(v)){if(ipv==='inet')out.push({lvl:'err',m:label+' ist IPv6, Regel ist IPv4'});return out;}
  const a=names.get(v);
  if(a){if(aliasCat(a.type)==='port')out.push({lvl:'err',m:label+': '+v+' ist ein Port-Alias'});return out;}
  if(ALIAS_RE.test(v))out.push({lvl:'warn',m:label+': Alias '+v+' nicht gefunden'});else out.push({lvl:'err',m:label+' ungültig: '+v});
  return out;
