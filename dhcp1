function applyRenames(){
  const ren=ALIAS.renames();if(!ren.length)return;
  const map=new Map(ren);
  const sw=t=>{const s=String(t||'');const neg=s.trim().startsWith('!');const v=neg?s.trim().slice(1).trim():s.trim();return map.has(v)?(neg?'!':'')+map.get(v):t;};
  S.data.rule.items.forEach(r=>{['src','dst','sport','dport'].forEach(k=>{r[k]=sw(r[k]);});});
  S.data.alias.items.forEach(a=>{const t=toks(a.content);if(t.some(x=>map.has(x)))a.content=t.map(x=>map.get(x)||x).join(' ');});
  $$('nat address, nat port, nat local-port, nat target, nat network, nat dstport, nat srcport',S.root).forEach(el=>{if(kids(el).length)return;const v=el.textContent.trim();const neg=v.startsWith('!');const b=neg?v.slice(1):v;if(map.has(b)){const hadC=[...el.childNodes].some(n=>n.nodeType===4);while(el.firstChild)el.removeChild(el.firstChild);const nv=(neg?'!':'')+map.get(b);el.appendChild(hadC?S.doc.createCDATASection(nv):S.doc.createTextNode(nv));}});
}
function commit(){
  const tot={add:0,upd:0,del:0};
  applyRenames();
  ORDER.forEach(k=>{
    const m=MODS[k],D=S.data[k];
    D.items.forEach(it=>{
      if(it.deleted){if(it.node){removeEl(it.node);tot.del++;}return;}
      if(it.isNew){m.create(it);tot.add++;return;}
      if(isChanged(m,it)){m.write(it,false);tot.upd++;}
    });
    D.items=D.items.filter(it=>!it.deleted);
    if(m.after)m.after();
    D.items.forEach(it=>{it.isNew=false;it.moved=false;it.orig=snap(m,it);});
  });
  const rev=kid(S.root,'revision');
  if(rev&&(tot.add||tot.upd||tot.del)){setTxt(rev,'time',String(Math.floor(Date.now()/1000)));setTxt(rev,'description','Config-Editor: '+tot.add+' neu, '+tot.upd+' geändert, '+tot.del+' entfernt');}
  let out=serialize(S.doc);if(!/^\s*<\?xml/.test(out))out=S.decl+'\n'+out;if(!out.endsWith('\n'))out+='\n';
  S.lastXml=out;S.baseText=out;
  return tot;
}
