const DHCP={
  key:'dhcp',label:'DHCP-Reservierungen',short:'DHCP',one:'Reservierung',many:'Reservierungen',
  fields:['scope','mac','ip','hostname','descr'],allowAll:true,canConvert:()=>Object.keys(S.data.dhcp.backends).length>1,
  parse(M){
    const D={items:[],scopes:{isc:[],kea:[]},backends:{}};
    const root=M.root,f=(b,scope,node,x)=>D.items.push(mk(DHCP,node,Object.assign({backend:b,scope:scope||''},x)));
    const dh=kid(root,'dhcpd');
    M.interfaces.forEach(i=>{if(!i.cidr)return;const sec=kid(dh,i.key);const r=kid(sec,'range');const a=ipToInt(txt(r,'from')),b=ipToInt(txt(r,'to'));
      D.scopes.isc.push({id:i.key,label:i.descr+' ('+i.cidr.label+')',short:i.descr,cidr:i.cidr,ifip:ipToInt(i.ip),pools:(a!=null&&b!=null)?[[a,b]]:[],enabled:!!(sec&&kid(sec,'enable'))});});
    let iscEn=false;
    kids(dh).forEach(sec=>{
      if(kid(sec,'enable'))iscEn=true;
      if(!D.scopes.isc.some(s=>s.id===sec.tagName)&&kids(sec,'staticmap').length){const i=M.interfaces.find(x=>x.key===sec.tagName);D.scopes.isc.push({id:sec.tagName,label:(i?i.descr:sec.tagName)+' (ohne feste Adresse)',short:i?i.descr:sec.tagName,cidr:null,ifip:null,pools:[]});}
      kids(sec,'staticmap').forEach(sm=>f('isc',sec.tagName,sm,{mac:txt(sm,'mac'),ip:txt(sm,'ipaddr'),hostname:txt(sm,'hostname'),descr:txt(sm,'descr')}));
    });
    if(M.type==='pfsense'||dh)D.backends.isc={label:M.type==='pfsense'?'DHCP-Server':'ISC DHCP',enabled:iscEn};
    const opn=kid(root,'OPNsense');const kea4=path(opn,'Kea','dhcp4');
    if(kea4){
      kids(kid(kea4,'subnets'),'subnet4').forEach(s=>{
        const sub=txt(s,'subnet');const [a,b]=sub.split('/');const c=cidrOf(a,parseInt(b,10));
        const pools=txt(s,'pools').split(/[\n,]+/).map(p=>p.trim()).filter(Boolean).map(p=>{if(p.includes('-')){const [x,y]=p.split('-').map(z=>ipToInt(z.trim()));return (x!=null&&y!=null)?[x,y]:null;}const [pa,pb]=p.split('/');const pc=cidrOf(pa,parseInt(pb,10));return pc?[pc.net,pc.bcast]:null;}).filter(Boolean);
        const ds=txt(s,'description');
        D.scopes.kea.push({id:s.getAttribute('uuid')||'',label:sub+(ds?' ('+ds+')':''),short:ds||sub,cidr:c,ifip:null,pools});
      });
      kids(kid(kea4,'reservations'),'reservation').forEach(r=>f('kea',txt(r,'subnet'),r,{mac:txt(r,'hw_address'),ip:txt(r,'ip_address'),hostname:txt(r,'hostname'),descr:txt(r,'description')}));
      D.backends.kea={label:'Kea DHCP',enabled:txt(kid(kea4,'general'),'enabled')==='1'};
    }
    const dmq=kid(opn,'dnsmasq');
    if(dmq){kids(dmq,'hosts').forEach(h=>f('dnsmasq','',h,{mac:txt(h,'hwaddr'),ip:txt(h,'ip'),hostname:txt(h,'host'),descr:txt(h,'descr')}));D.backends.dnsmasq={label:'Dnsmasq',enabled:txt(dmq,'enable')==='1'};}
    M.data.dhcp=D;
  },
  D(){return S.data.dhcp;},
  defBackend(){
    const D=this.D();const b=Object.entries(D.backends);if(!b.length)return 'isc';
    const en=b.filter(([,v])=>v.enabled);const pool=en.length?en:b;
    const n=k=>D.items.filter(e=>e.backend===k).length;
