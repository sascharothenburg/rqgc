  if(S.type==='pfsense')out=out.replace(/<([A-Za-z_][\w.\-]*)((?:\s+[\w.\-:]+="[^"]*")*)\s*\/>/g,'<$1$2></$1>');
  return out;
}
function mk(mod,node,f){const it=Object.assign({id:seq++,node,isNew:false,deleted:false,moved:false},f);it.orig=snap(mod,it);return it;}
function snap(mod,it){const o={};mod.fields.forEach(k=>o[k]=it[k]);return o;}
function isChanged(mod,it){return !it.isNew&&!it.deleted&&(it.moved||mod.fields.some(k=>norm(it[k])!==norm(it.orig[k])));}
function ifLabelIn(M,k){const i=M.interfaces.find(x=>x.key===k);if(i)return i.descr;return ({floating:'Floating',openvpn:'OpenVPN',enc0:'IPsec',ipsec:'IPsec',wireguard:'WireGuard',l2tp:'L2TP',pppoe:'PPPoE-Server',lo0:'Loopback'})[k]||String(k).toUpperCase();}
const ifLabel=k=>ifLabelIn(S,k);
function sel(key,label,opts,val){return '<label class="f">'+esc(label)+'<select data-o="'+esc(key)+'">'+opts.map(([v,l])=>'<option value="'+esc(v)+'"'+(String(v)===String(val)?' selected':'')+'>'+esc(l)+'</option>').join('')+'</select></label>';}
function chk(key,label,val){return '<label class="chk"><input type="checkbox" data-o="'+esc(key)+'"'+(val?' checked':'')+'> '+esc(label)+'</label>';}

