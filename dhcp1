  const out=[];let cur='',q=false;
  for(let i=0;i<line.length;i++){const ch=line[i];
    if(q){if(ch==='"'){if(line[i+1]==='"'){cur+='"';i++;}else q=false;}else cur+=ch;}
    else if(ch==='"')q=true;else if(ch===d){out.push(cur);cur='';}else cur+=ch;}
  out.push(cur);return out.map(s=>s.trim());
}
function parsePaste(){
  const m=mod();const text=($('#impText').value||'').replace(/^\ufeff/,'');
  const lines=text.split(/\r?\n/).filter(l=>l.trim()&&!/^\s*#/.test(l));
  const prev=IMP.pm[S.tab];
  if(!lines.length){IMP.pm[S.tab]={table:null,mapping:[],touched:prev&&prev.touched};renderMapping();return;}
  const sample=lines.slice(0,10);let d=' ',best=0;
  ['\t',';',','].forEach(c=>{const n=Math.min(...sample.map(l=>l.split(c).length-1));if(n>best){best=n;d=c;}});
  if(d===' '&&S.tab!=='dhcp')d=lines[0].includes('\t')?'\t':';';
  const table=lines.map(l=>splitLine(l,d));const ncol=Math.max(...table.map(r=>r.length));
  const first=table[0];const hk=first.map(h=>m.headerKey(h));
  let header=false,mapping;
  const looksData=first.some(v=>normMac(v)||isV4(v));
  if(hk.filter(Boolean).length>=2&&!looksData){header=true;mapping=hk.concat(new Array(Math.max(0,ncol-hk.length)).fill(''));}
  else mapping=m.autoMap(table,ncol);
  if(prev&&prev.touched&&prev.mapping.length===ncol&&prev.header===header)mapping=prev.mapping;
  IMP.pm[S.tab]={table:header?table.slice(1):table,header,headRow:header?first:null,mapping,touched:prev&&prev.touched&&prev.mapping.length===ncol};
  renderMapping();
}
function renderMapping(){
  const box=$('#impMap');const P=IMP.pm[S.tab];
  if(!P||!P.table||!P.table.length){box.innerHTML='';return;}
  const opts=[['','nicht verwenden']].concat(mod().impFields);
  box.innerHTML=P.mapping.map((m,i)=>{const s=(P.headRow&&P.headRow[i])||(P.table[0][i]||'');return '<label>Spalte '+(i+1)+'<code title="'+esc(s)+'">'+esc(s||'leer')+'</code><select data-col="'+i+'">'+opts.map(([v,l])=>'<option value="'+v+'"'+(v===m?' selected':'')+'>'+esc(l)+'</option>').join('')+'</select></label>';}).join('');
}
$('#impMap').addEventListener('change',ev=>{const s=ev.target.closest('select[data-col]');if(!s)return;const P=IMP.pm[S.tab];P.mapping[+s.dataset.col]=s.value;P.touched=true;IMP.override.clear();buildPreview();});
function importRows(){
  const m=mod();
  if(IMP.src==='paste'){const P=IMP.pm[S.tab];if(!P||!P.table)return [];
    return P.table.map(r=>{const o={};m.impFields.forEach(([k])=>{const i=P.mapping.indexOf(k);o[k]=i>=0?(r[i]||''):'';});return o;}).filter(o=>Object.values(o).some(v=>String(v).trim()));}
  if(IMP.src==='config')return IMP.cfg?m.rowsFromConfig(IMP.cfg):[];
  return m.rowsFromConvert?m.rowsFromConvert():[];
}
function buildPreview(){
  if($('#imp').hidden)return;
  refreshIssues();
  const rows=importRows();IMP.preview=mod().preview(rows,IMP.src);
  IMP.preview.forEach((p,i)=>{p.checked=IMP.override.has(i)?IMP.override.get(i):(p.status==='new'||p.status==='upd');if(p.status==='err'||p.status==='skip')p.checked=false;});
  renderPreview();
}
function renderPreview(){
  const wrap=$('#impPrevWrap'),tbl=$('#impPrev'),P=IMP.preview;
  if(!P.length){wrap.hidden=true;$('#impSum').textContent=IMP.src==='config'&&!IMP.cfg?'Noch keine zweite Datei geladen.':'Noch nichts zum Importieren.';$('#impApply').disabled=true;$('#impApply').textContent='Übernehmen';return;}
  wrap.hidden=false;
  const lbl={new:'Neu',upd:'Aktualisieren',skip:'Überspringen',err:'Fehler'};
  tbl.innerHTML='<thead><tr><th style="width:36px"></th><th>Status</th>'+mod().previewHead().map(h=>'<th>'+esc(h)+'</th>').join('')+'<th>Hinweis</th></tr></thead><tbody>'+
    P.map((p,i)=>'<tr class="'+p.status+'"><td><input type="checkbox" class="ck" data-i="'+i+'"'+(p.checked?' checked':'')+(p.status==='err'||p.status==='skip'?' disabled':'')+' aria-label="Zeile übernehmen"></td><td><span class="pill '+p.status+'">'+lbl[p.status]+'</span></td>'+p.cells.map(([v,c])=>'<td'+(c?' class="'+c+'"':'')+' title="'+esc(v)+'">'+esc(v)+'</td>').join('')+'<td class="note'+(p.status==='err'?' err':'')+'">'+esc(p.notes.join(', '))+'</td></tr>').join('')+'</tbody>';
  const k={new:0,upd:0,skip:0,err:0};P.forEach(p=>k[p.status]++);const n=P.filter(p=>p.checked).length;
  const parts=[];if(k.new)parts.push(k.new+' neu');if(k.upd)parts.push(k.upd+' zu aktualisieren');if(k.skip)parts.push(k.skip+' übersprungen');if(k.err)parts.push(k.err+' mit Fehlern');
  $('#impSum').textContent=P.length+' Zeilen: '+parts.join(', ');
  const b=$('#impApply');b.disabled=!n;b.textContent=n?n+' übernehmen':'Übernehmen';
}
$('#impPrev').addEventListener('change',ev=>{const c=ev.target.closest('input[data-i]');if(!c)return;const i=+c.dataset.i;IMP.override.set(i,c.checked);IMP.preview[i].checked=c.checked;renderPreview();});
$('#impApply').addEventListener('click',()=>{
  const m=mod();const list=IMP.preview.filter(p=>p.checked);if(!list.length)return;
  IMP.extraMsg='';const n=m.apply(list,IMP.src);
  S.confirmErr=false;const v=view();v.q='';$('#q').value='';
  if(IMP.src==='paste'){IMP.texts[S.tab]='';$('#impText').value='';delete IMP.pm[S.tab];renderMapping();}
  IMP.override.clear();closeImport();renderAll();
  toast(n+' '+(n===1?m.one:m.many)+' übernommen.'+IMP.extraMsg+' Mit „Speichern“ wird die Datei erzeugt.');
});

/* ================= loading ================= */
$('#file1').addEventListener('change',ev=>{const f=ev.target.files[0];ev.target.value='';if(f)openFile(f);});
$('#file2').addEventListener('change',ev=>{const f=ev.target.files[0];ev.target.value='';if(f)openFile(f);});
$('#pasteCfgBtn').addEventListener('click',()=>{const t=$('#pasteCfg').value;if(!t.trim())return;try{loadText(t,'config.xml');}catch(err){const b=$('#loadErr');b.textContent=err.message;b.hidden=false;}});
const drop=$('#drop');
['dragenter','dragover'].forEach(t=>document.addEventListener(t,ev=>{ev.preventDefault();if(!$('#start').hidden)drop.classList.add('over');}));
document.addEventListener('dragleave',ev=>{if(ev.target===document.documentElement||ev.target===document.body)drop.classList.remove('over');});
document.addEventListener('drop',ev=>{ev.preventDefault();drop.classList.remove('over');const f=ev.dataTransfer&&ev.dataTransfer.files[0];if(!f)return;
  if(S&&!$('#imp').hidden&&IMP.src==='paste'&&/\.(csv|txt|tsv)$/i.test(f.name)){f.text().then(t=>{$('#impText').value=t;IMP.texts[S.tab]=t;delete IMP.pm[S.tab];IMP.override.clear();parsePaste();buildPreview();});return;}
  openFile(f);});
let toastT=null;
function toast(m){const t=$('#toast');t.textContent=m;t.hidden=false;clearTimeout(toastT);toastT=setTimeout(()=>t.hidden=true,5500);}
window.__cfgEditor={loadText,commit,get state(){return S;},get imp(){return IMP;}};
})();
</script>
