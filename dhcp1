async function offerFile(name,data,mime){
  let api=null;const hasClaude=!!(window.claude&&typeof window.claude.use==='function');
  if(hasClaude){try{api=await window.claude.use('downloads');}catch(_){api=null;}}
  if(api){
    try{await api.save({filename:name,data});return {ok:true,name};}
    catch(err){const code=err&&err.code;
      if(code==='rejected_extension'&&/\.xml$/i.test(name)){try{await api.save({filename:name+'.txt',data});return {ok:true,name:name+'.txt',renamed:true};}catch(e2){return {ok:false,code:e2&&e2.code};}}
      return {ok:false,code};}
  }
  if(hasClaude)return {ok:false,code:'unavailable'};
  const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([data],{type:mime}));a.download=name;document.body.appendChild(a);a.click();
  setTimeout(()=>{URL.revokeObjectURL(a.href);a.remove();},1500);
  return {ok:true,name};
}
