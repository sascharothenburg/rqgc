  },
  defaultGroup(){return Object.keys(this.D().backends).length>1?this.defBackend():'all';},
  groups(){const D=this.D();const bes=Object.keys(D.backends);if(bes.length<2)return null;
    return bes.map(b=>({id:b,label:D.backends[b].label,count:D.items.filter(e=>e.backend===b&&!e.deleted).length,note:D.backends[b].enabled?'aktiv':''}));},
  groupOf:it=>it.backend,
  summary(){const D=this.D();const n=D.items.filter(e=>!e.deleted).length;return n+' '+(n===1?'Reservierung':'Reservierungen')+'. Interfaces mit fester IPv4-Adresse: '+(D.scopes.isc.filter(s=>s.cidr).map(s=>s.short).join(', ')||'keine');},
  subgroups(g){const D=this.D();const bes=Object.keys(D.backends);const b=g==='all'?(bes.length===1?bes[0]:null):g;if(b!=='isc'&&b!=='kea')return null;return D.scopes[b].map(s=>({id:s.id,label:s.label}));},
  subOf:it=>it.scope,subAll:'Alle Netze',
